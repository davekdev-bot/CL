# Copy this file to .env.local and fill in your own values. Never commit .env.local.
API_BACKEND_HOST=127.0.0.1
API_BACKEND_PORT=5000
API_PAYLOAD_MAX_SIZE=7mb

# Gemini Developer API (Google AI Studio). Required for Gemini provider.
GEMINI_API_KEY=X
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API. Required for OpenAI provider; API billing may be separate from ChatGPT subscription.
GEMINI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Optional legacy Vertex AI proxy. Leave disabled unless you explicitly need the old Google Cloud proxy.
ENABLE_LEGACY_VERTEX_PROXY=false
GOOGLE_CLOUD_LOCATION=
GOOGLE_CLOUD_PROJECT=
PROXY_HEADER=

# Keep TRUST_PROXY=false for local development.
TRUST_PROXY=false
